# Place actual runtime configuration in ignored .dev.vars for local development.
# Set production values via Cloudflare dashboard or wrangler secret put.
ENVIRONMENT=production
SITE_ORIGIN=https://projects.example.com
ACCESS_ISSUER=https://YOUR-TEAM.cloudflareaccess.com
ACCESS_AUDIENCE=YOUR-ACCESS-APPLICATION-AUD
ACCESS_OWNER_SUBJECTS=YOUR-OWNER-SUBJECT-UUID
CSRF_SECRET=GENERATE-A-RANDOM-SECRET-OF-AT-LEAST-32-CHARACTERS
# DB, BUCKET and ADMIN_RATE_LIMITER are runtime bindings, not string variables.
